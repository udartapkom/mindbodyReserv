# MindBodyHub API — шаблон окружения
# Скопируйте: cp .env.example .env
# Секреты не коммитить. Runbook: docs/security-runbook.md

NODE_ENV=development
PORT=4000

# CORS: через запятую. В production обязателен allowlist.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=mindbodyhub
DB_PASSWORD=devpassword
DB_NAME=mindbodyhub

# --- JWT (access) ---
# Refresh — opaque token в БД (SHA-256), отдельный JWT_REFRESH_SECRET НЕ нужен и не используется.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Первый админ (только bootstrap) ---
# После успешного seed удалите ADMIN_PASSWORD из prod .env и перезапустите API.
# См. docs/security-runbook.md § Admin seed
ADMIN_PHONE=+79991234567
ADMIN_PASSWORD=ChangeMe_Admin1!

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_MATERIALS=materials

# Docker Compose MinIO root (локально часто = ACCESS/SECRET выше)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Platega (опционально локально; на prod обязательны для оплат) ---
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_SUCCESS_URL=http://localhost:3000/cabinet
PLATEGA_FAIL_URL=http://localhost:3000/price

# --- VK-алерты админу (опционально) ---
VK_BOT_TOKEN=
VK_ADMIN_ID=
ADMIN_PANEL_URL=http://localhost:5173

# --- Web Push / VAPID (опционально; без ключей push выключен) ---
# Генерация: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@mindbodyhub.pro

# --- Deploy metadata (обычно выставляет deploy-remote.sh) ---
# DEPLOY_VERSION=
# GIT_SHA=
# ADMIN_VERSION_FILE=
# FRONT_VERSION_FILE=
# PM2_BIN=
